# 이 파일을 .env로 복사해서 값을 채운다: cp .env.example .env
# 개인키는 반드시 .env에만 넣는다. .env는 git에 올라가지 않지만(*.env), 이 .env.example은 올라간다.

# 봇 전용 지갑의 개인키 (Sepolia 테스트 ETH만 있는 개발용 지갑)
KEEPER_PRIVATE_KEY=

# 선택: 기본값은 무료 공개 노드
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 선택: 기본값은 ../frontend/src/contracts/deployments.json의 Sepolia 대출 풀 주소
# POOL_ADDRESS=0x...

# 선택: 점검 주기(초)와 한 번에 점검할 포지션 수 (1~3, 컨트랙트 최대 3)
# INTERVAL_SECONDS=60
# CHECKS_PER_TICK=1
